# 运行数据、模型与本地环境不入库
/*
!/.gitignore
!/.gitattributes
!/README.md
!/start.py
!/start.bat
!/AGENTS.md
!/requirements.txt
!/.env.example
!/app/
!/web/
!/knowledge/
!/scripts/
!/tests/
!/docs/

# 依赖与构建产物
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.cache/
/web/dist/
**/.vite/
**/*.tsbuildinfo

# 模型权重与向量资产
/models/
**/*.npz
**/*.safetensors
**/*.gguf
**/*.bin
**/*.sqlite
**/*.sqlite3
**/*.db

# 运行数据
/data/
/log/
**/*.log
**/*.pid

# 本地密钥
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/id_rsa
**/id_ed25519
**/~$*
**/*.tmp
**/*.zip

# 评测结果文件（每次运行生成）
tests/eval/results-*.json

# docling 独立运行时（可重建，不入库）
.venv-docling/
