# 复制为 .env 后按需修改；.env 不入库
# 生成模型：OpenAI 兼容接口。正式使用填写外部 API；本地联调填本地服务。
# 火山方舟（OpenAI 兼容）示例：
#   POLICYRAG_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
#   POLICYRAG_LLM_MODEL=deepseek-v4.1-flash
# 注意：方舟的 /api/v3 与 /api/coding/v3 是不同入口，密钥与可用模型可能不同。
POLICYRAG_LLM_BASE_URL=http://127.0.0.1:8081/v1
POLICYRAG_LLM_API_KEY=
POLICYRAG_LLM_MODEL=Qwen3.8-27B
# 推理型模型默认关闭深度思考；服务不认这个参数时改成 none
POLICYRAG_LLM_THINKING=disabled

# 向量后端：chroma（默认）或 npz（零依赖回退）
POLICYRAG_VECTOR_BACKEND=chroma
# auto / cuda / cpu
POLICYRAG_DEVICE=auto

# 交叉编码器重排（bge-reranker-v2-m3）；设为 0 关闭
POLICYRAG_RERANK=1
# 留空则用 models/bge-reranker-v2-m3
POLICYRAG_RERANK_MODEL_DIR=
POLICYRAG_RERANK_TOP_N=20
POLICYRAG_RERANK_BATCH=16

# 扫描件 OCR：文本层不足的页渲染成 PNG 后 POST 到该端点
# 契约：multipart 字段 image，返回 {"code": 0, "result": "markdown"}（与 RAG 项目一致）
POLICYRAG_OCR_ENDPOINT=
POLICYRAG_OCR_DPI=200
POLICYRAG_OCR_MIN_CHARS=20
POLICYRAG_OCR_TIMEOUT=180
POLICYRAG_OCR_MAX_PAGES=100

# PDF 解析后端：pymupdf（默认，快）或 docling（版式/表格更强，走外部解释器）
# docling 默认复用同盘 RAG 项目的运行时与模型；不存在时留空即可
POLICYRAG_PARSER_PDF=pymupdf
POLICYRAG_DOCLING_PYTHON=
POLICYRAG_DOCLING_ARTIFACTS=
POLICYRAG_DOCLING_DEVICE=cuda
POLICYRAG_DOCLING_TIMEOUT=600

# DOCX 页图：用本机 Word 把 DOCX 另存 PDF 供原文预览（无 Word 自动跳过）
POLICYRAG_DOCX_PREVIEW=1
POLICYRAG_DOCX_PREVIEW_TIMEOUT=120

# 服务端口
POLICYRAG_HOST=127.0.0.1
POLICYRAG_PORT=7880
