# 复制为 .env 后按需修改；.env 不入库
# 生成模型：OpenAI 兼容接口。正式使用填写外部 API；本地联调填本地服务。
POLICYRAG_LLM_BASE_URL=http://127.0.0.1:8081/v1
POLICYRAG_LLM_API_KEY=
POLICYRAG_LLM_MODEL=Qwen3.8-27B

# 向量后端：chroma（默认）或 npz（零依赖回退）
POLICYRAG_VECTOR_BACKEND=chroma
# auto / cuda / cpu
POLICYRAG_DEVICE=auto

# 服务端口
POLICYRAG_HOST=127.0.0.1
POLICYRAG_PORT=7880
